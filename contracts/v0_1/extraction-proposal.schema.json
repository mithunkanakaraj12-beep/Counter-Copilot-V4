        "value": {
          "title": "Value",
          "type": "null"
        },
        "candidates": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Candidates",
          "type": "array"
        },
        "ambiguity_reason": {
          "enum": [
            "conflicting_statements",
            "multiple_interpretations",
            "range_given",
            "unrecognized_term",
            "unclear_reference",
            "unreadable",
            "negated",
            "approximate",
            "relative_quantity",
            "number_word",
            "separate_measurements",
            "quoted_history_only"
          ],
          "title": "Ambiguity Reason",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ProposedEvidence"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
